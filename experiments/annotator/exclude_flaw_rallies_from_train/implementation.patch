+"""Reuse validation exports and the existing 40-video contact trees."""
+
+import argparse
+from dataclasses import replace
+from pathlib import Path
+
+from annotator.models import load_models, save_models
+from experiments.annotator.monotrack_benchmark.writeup_scripts.annotator_batch_runs import BatchPaths, prepare_run_policy
+
+
+def link(source: Path, destination: Path) -> None:
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    if destination.exists():
+        assert destination.resolve() == source.resolve()
+    else:
+        destination.symlink_to(source, target_is_directory=True)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--run', type=Path, required=True)
+    args = parser.parse_args()
+    run = args.run.resolve()
+    training = run / 'training'
+    models_40 = run / 'reporting/models_40'
+    aliases = run / 'reporting/training'
+    predictions = run / 'reporting/annotator_runs'
+    link(training, aliases / 'no_max')
+    prepare_run_policy(BatchPaths(aliases, models_40, predictions, {}, ('no_max',)), 'no_max')
+    old = Path('experiments/annotator/tree_simplification/results/discovery_context/no_max')
+    for seed in (0, 100, 200, 300, 400):
+        models = load_models(training / 'models' / f'raw_baseline-seed-{seed}')
+        previous = load_models(old / 'models_40' / f'seed-{seed}')
+        assert (models.preprocessing, models.contact_settings, models.side_geometry) == (
+            previous.preprocessing, previous.contact_settings, previous.side_geometry)
+        save_models(replace(models, contact=previous.contact), models_40 / 'no_max' / f'seed-{seed}')
+        streams = training / f'test-run/candidates/raw_baseline/seed-{seed}/export/streams'
+        assert len(list(streams.glob('sset_*.json.gz'))) == 8
+        link(streams, predictions / 'no_max/validation/32_videos' / f'seed-{seed}')
+    print('Reused 40 validation streams and five 40-video contact trees.', flush=True)
+
+
+if __name__ == '__main__':
+    main()
