@@ -0,0 +1,53 @@
+"""Convert the saved no-max pools once, retaining evidence and refreshing labels."""
+
+import argparse
+from concurrent.futures import ProcessPoolExecutor
+from pathlib import Path
+
+from annotator.training import sequences
+from annotator.training.label_quality import load_rally_exclusions
+from experiments.annotator.development import read_json, write_json
+from experiments.annotator.tree_simplification.pools import SCHEMA, PoolJob, _prepare_pool
+
+
+# Only this one-off reader opens the retired boundary-policy pickle. Replacing
+# the dataclasses below discards the retired field before writing current pools.
+class RetiredBoundaryPolicy:
+    pass
+
+
+setattr(sequences, 'RallyBoundaryPolicy', RetiredBoundaryPolicy)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--workers', type=int, default=28)
+    args = parser.parse_args()
+    jobs = []
+    for source in sorted(args.source.glob('test-run/candidates/*/seed-*/pools')):
+        output = args.output / source.relative_to(args.source)
+        old = read_json(source / 'pools.json.gz')
+        assert old['schema'] == 'tree-simplification-option-pools/1'
+        assert old['boundary_policy'] == {'before_seconds': None, 'after_seconds': None}
+        manifest = {key: old[key] for key in ('prepared', 'contact_run', 'settings', 'max_edits', 'deletion_candidates')}
+        manifest.update(schema=SCHEMA, unjudgeable_rallies=sorted([vid, rally] for vid, rally in load_rally_exclusions()))
+        output.mkdir(parents=True, exist_ok=True)
+        write_json(output / 'pools.json.gz', manifest)
+        for path in sorted((source / 'videos').glob('*.joblib')):
+            destination = output / 'videos' / path.name
+            if destination.exists() and destination.with_suffix('.json.gz').exists():
+                continue
+            record = read_json(path.with_suffix('.json.gz'))
+            jobs.append(PoolJob(path.stem, record['group'], record['split'],
+                                Path(old['prepared']) / 'videos' / path.name, Path('unused'), output,
+                                old['settings']['contact_prediction'], old['max_edits'], old['deletion_candidates'], path))
+    print(f'Refreshing {len(jobs)} cached pools with {args.workers} workers', flush=True)
+    with ProcessPoolExecutor(max_workers=args.workers) as executor:
+        for number, summary in enumerate(executor.map(_prepare_pool, jobs), 1):
+            print(f'{number}/{len(jobs)} {summary["video"]}: {summary["options"]} options', flush=True)
+
+
+if __name__ == '__main__':
+    main()
