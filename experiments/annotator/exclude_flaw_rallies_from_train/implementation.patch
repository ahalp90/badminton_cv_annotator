@@ -0,0 +1,97 @@
+"""Score new annotator predictions and reuse unchanged benchmark reference results."""
+
+import argparse
+import json
+import shutil
+from concurrent.futures import ProcessPoolExecutor
+from pathlib import Path
+
+import pandas as pd
+
+from experiments.annotator.monotrack_benchmark.benchmark_scripts.common import load_manifest, read_json, write_json
+from experiments.annotator.monotrack_benchmark.writeup_scripts import metrics
+
+CONDITIONS = {
+    'annotator_our_courts': ('our_courts/32_videos', True),
+    'annotator_monotrack_courts': ('monotrack_courts/32_videos', True),
+    'annotator40_our_courts': ('our_courts/40_videos', True),
+    'annotator40_monotrack_courts': ('monotrack_courts/40_videos', True),
+    'annotator_body_window_36_our_courts': ('our_courts/body_window_36', True),
+    'annotator_discovery': ('discovery/32_videos', False),
+    'annotator40_discovery': ('discovery/40_videos', False),
+}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--predictions', type=Path, required=True)
+    parser.add_argument('--baseline', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--workers', type=int, default=28)
+    args = parser.parse_args()
+    if not args.out.exists():
+        shutil.copytree(args.baseline, args.out)
+    summary = json.loads((args.baseline / 'contact_summary.json').read_text())['summary']
+    items = load_manifest(metrics.INPUTS)['items']
+    windows = {key: metrics.left_out_windows(rallies) for key, rallies in metrics.test_left_out().items()}
+    per_video = {}
+    with ProcessPoolExecutor(max_workers=args.workers) as executor:
+        for name, (relative, supplied) in CONDITIONS.items():
+            runs = []
+            for seed in metrics.SEEDS:
+                cache = args.out / 'cache' / name / f'seed-{seed}.json.gz'
+                if cache.exists():
+                    stored = read_json(cache)
+                else:
+                    root = args.predictions / 'test' / relative / f'seed-{seed}'
+                    tasks = []
+                    for item in items:
+                        result = read_json(root / f'{item["item_id"]}.json.gz')
+                        stream = result['stream'] if supplied else result
+                        for tolerance in metrics.TOLERANCES:
+                            tasks.append((item, stream, tolerance, windows[item['item_id']], supplied))
+                    rows, found = [], []
+                    for task, (counts, judged) in zip(tasks, executor.map(metrics.score_task, tasks), strict=True):
+                        item, _, tolerance, _, _ = task
+                        rows.append({'video': int(item['video_id']), 'tolerance': tolerance, **counts})
+                        if tolerance == 10:
+                            found.extend(row | {'video': int(item['video_id'])} for row in judged)
+                    stored = {'per_video': rows, 'found': found}
+                    write_json(cache, stored)
+                run = {key: pd.DataFrame(value) for key, value in stored.items()}
+                scores = args.predictions / 'test' / relative / f'seed-{seed}/scores.json.gz'
+                metrics.check_against_saved(name, run['per_video'], read_json(scores))
+                runs.append(run)
+                if not supplied:
+                    run['found'].to_csv(args.out / f'found_rallies_{name}_seed{seed}.csv.gz', index=False)
+                print(f'{name}/seed-{seed} scored', flush=True)
+            condition = {'name': name, 'supplied': supplied, 'runs': runs}
+            summary[name] = metrics.summarise(condition)
+            per_video[name] = metrics.per_video_mean(condition)
+            per_video[name].to_csv(args.out / f'per_video_{name}.csv')
+            if name == 'annotator_discovery':
+                curves = metrics.confidence_curve(condition, 3327)
+                for seed, frame in zip(metrics.SEEDS, curves['runs'], strict=True):
+                    frame.to_csv(args.out / f'confidence_curve_seed{seed}.csv', index=False)
+    for name in ('monotrack_own_courts', 'monotrack_our_courts', 'heuristic_our_courts'):
+        per_video[name] = pd.read_csv(args.baseline / f'per_video_{name}.csv', index_col='video')
+    pairs = {
+        'annotator_minus_monotrack_own_courts': ('annotator_our_courts', 'monotrack_own_courts'),
+        'annotator_minus_monotrack_on_monotrack_courts': ('annotator_monotrack_courts', 'monotrack_own_courts'),
+        'annotator_own_minus_monotrack_courts': ('annotator_our_courts', 'annotator_monotrack_courts'),
+        'monotrack_own_minus_our_courts': ('monotrack_own_courts', 'monotrack_our_courts'),
+        'heuristic_minus_monotrack_own_courts': ('heuristic_our_courts', 'monotrack_own_courts'),
+    }
+    paired = {name: metrics.paired_bootstrap(per_video[first], per_video[second])
+              for name, (first, second) in pairs.items()}
+    (args.out / 'contact_summary.json').write_text(json.dumps({'summary': summary, 'paired': paired}, indent=1))
+    write_json(args.out / 'evaluation-policy.json.gz', {
+        'training_labels': 'whole-rally exclusions; all contacts retained',
+        'boundary_basis': metrics.DISCOVERY_BOUNDARY_BASIS,
+        'boundary_policy': {'before_seconds': None, 'after_seconds': None},
+    })
+    print('All seven annotator conditions scored; reference systems reused.', flush=True)
+
+
+if __name__ == '__main__':
+    main()
