# ---------------------------------------------------------------------------
# Project model and data dirs split across two roots. See runtime/README.md and
# training/README.md for the full layout. Directory structure is tracked via
# .gitkeep; model and data contents are generally not.
#
#   runtime/                — classifier and perception artefacts.
#     deployed/<arch>/      — retained model packages and evaluation results.
#     checkpoints/<dep>/    — third-party perception weights used by pipelines.
#
#   training/               — source data, caches and training runs.
#     data/                 — source training data (ShuttleSet).
#     <arch>/cache/         — re-derivable per-architecture preprocessing.
#     <arch>/experiments/   — training run manifests, metrics, weights.
# ---------------------------------------------------------------------------

# runtime/
runtime/checkpoints/tracknetv3/*
!runtime/checkpoints/tracknetv3/.gitkeep
runtime/checkpoints/yolo11/*
!runtime/checkpoints/yolo11/.gitkeep

# Local TrackNetV3 and InpaintNet weights for the shared inference tree.
src/shared/tracknetv3/ckpts/

# training/
training/data/shuttleset/clips/*
!training/data/shuttleset/clips/.gitkeep
training/data/shuttleset/rally_clips/*
!training/data/shuttleset/rally_clips/.gitkeep
training/data/shuttleset/raw_video/*
!training/data/shuttleset/raw_video/.gitkeep

training/bric/cache/players/*
!training/bric/cache/players/.gitkeep
training/bric/cache/shuttle/*
!training/bric/cache/shuttle/.gitkeep
training/bric/cache/rgb/*
!training/bric/cache/rgb/.gitkeep
training/bric/cache/validation/

training/bric/experiments/*
!training/bric/experiments/.gitkeep

# Ultralytics auto-downloads YOLO weights into the current working directory
# (or to ~/.cache/ultralytics/) on first use. Catch any that land in the repo
# root regardless. Production code should explicitly load from
# runtime/checkpoints/yolo11/.
yolo*.pt
*.engine

# Ultralytics training/predict default output dir
runs/
!/experiments/annotator/runs/

# Claude Code local workspace settings
.claude/

# Local-only large data SCP'd from Engelbart (542MB collations)
scratch/bst_x_inputs/

# Private dev scribbles. Outside the tracked scratch/README.md contract.
local_scratch/

# Keep timestamped trajectory runs local. The canonical investigation has its
# own ignore rules for frozen inputs and generated outputs.
scratch/serve_start_trajectory_exploration/20*/
**/external_delegate/

# Machine-local Pyrefly profile for Serena. CI uses [tool.pyrefly] in pyproject.toml.
pyrefly.toml

CLAUDE.md

# --- Heavy ML artifacts: keep new ones out of git (see MODELS.md) ---
# Run-time weights are published as GitHub Release assets and fetched via scripts/fetch-models.sh; 
# the training archive lives in bulk storage.
# TB event files + prediction .npz are deliberately TRACKED (small, source of
# truth for training curves + re-derivable analysis)
**/weights/*.pt
runtime/deployed/**/*.pt

# rtmlib-migration gate run artifacts: written to CWD, regenerated per run, never
# a source of truth (gates re-derive from committed raw; the sample list from
# make_phase_a_sample.py is deterministic).
*_parity.json
*_selfvariance.json
phase_a_stems.txt

# Commentary-scraper output root (annotator/config.py default; BADMINTON_SCRAPE_DIR overrides)
data/scrape_output/
