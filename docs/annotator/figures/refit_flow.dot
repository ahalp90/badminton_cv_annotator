digraph refit {
  graph [rankdir=TB, pad="0.25", nodesep="0.35", ranksep="0.35", bgcolor="white", label="Training steps", labelloc=t, fontname="Helvetica", fontsize=13];
  node [shape=box, style="rounded", fontname="Helvetica", fontsize=11, margin="0.12,0.08"];
  edge [fontname="Helvetica", fontsize=9];

  data [label="Separate train, validation and test videos\nkeep related footage together · at least 3 training groups"];
  contact [label="Fit the contact models and first rally selector\nkeep full-data models for deployment\nretain one contact model excluding each group"];
  fixed [label="For each held-out group, reuse its contact model\nscore the remaining videos once"];
  examples [label="Keep ordinary examples from the contact scores\nfit temporary first selectors on the remaining groups\nto generate split-piece examples"];
  held [label="Fit a second selector on those examples\npredict the held-out group with both selectors"];
  collect [label="Collect each held-out group's results\nfirst-pass piece examples for second-selector training\nfinal corrected outputs for review training"];
  final [label="Fit the final second selector and review model\nsecond selector: ordinary + collected piece examples\nreview: collected final outputs and correctness labels"];
  bundle [label="Save four models and shared settings\ncontact · first selector · second selector · review"];
  validation [label="Choose settings and seed on validation\nthen report test results separately"];

  data -> contact -> fixed -> examples -> held -> collect -> final -> bundle -> validation;
}
