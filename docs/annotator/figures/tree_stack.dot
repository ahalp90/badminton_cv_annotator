digraph tree_stack {
  rankdir=TB;
  graph [fontname="Helvetica", bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.45];
  node [shape=box, style="rounded,filled", fillcolor="white", color="black", fontcolor="black", fontname="Helvetica", fontsize=10.5, margin="0.12,0.08"];
  edge [color="black", fontcolor="black", fontname="Helvetica", fontsize=9];

  candidates [label="Candidate frames nominated by the priors\n85 physical/validity features each"];
  contact [label="1. Contact tree\nscore every candidate frame"];
  initial [label="Initial contacts\nscore ≥ 0.9 + nearby suppression"];
  pool [label="All scored candidates\nincluding lower-scoring rows"];
  shortlist [label="Shortlist additions\nup to 2 earlier serves + 6 later contacts"];
  options [label="No-edit + contact toggles\nup to 3 additions/deletions combined\ndelete from first contact + 5 weakest others"];
  selector [label="2. Rally selector\nscore alternatives and choose one per rally"];
  finish [label="Finish selected rallies\nboundary widening · Top/Bot alternation"];
  review [label="3. Review tree\nreview priority; does not edit annotations"];

  candidates -> contact;
  contact -> initial;
  contact -> pool;
  initial -> shortlist;
  pool -> shortlist;
  initial -> options;
  shortlist -> options;
  options -> selector -> finish -> review;
  options -> review [label="selected-option evidence"];
  selector -> review [label="score + margin"];
}
