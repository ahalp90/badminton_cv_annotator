digraph tree_stack {
  graph [rankdir=TB, fontname="Helvetica", bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
  node [shape=box, style="rounded,filled", fillcolor="white", color="black", fontcolor="black", fontname="Helvetica", fontsize=10.5, margin="0.12,0.08"];
  edge [color="black", fontcolor="black", fontname="Helvetica", fontsize=9];

  candidates [label="Candidate frames\n90 physical and tracking features each"];
  contact [label="1. Contact model\nscore every candidate"];
  selected [label="Initial hits\nscore ≥ 0.9 · suppress nearby duplicates"];
  pool [label="Keep all scored candidates\nincluding rejected frames"];
  options [label="Build alternatives for each rough rally\nunchanged contacts + up to 3 additions/deletions"];
  first [label="2. First rally selector\nchoose one alternative and finish bounds/player order"];
  split [label="Split gaps over 3 seconds\nordinary and supplied-bound rallies bypass correction"];
  piece_options [label="Rebuild alternatives for each split piece\nrecover rejected candidates · keep unchanged option\nmidpoint margin prevents duplicates across pieces"];
  second [label="3. Second rally selector\nsame features and proposal code · separate fitted weights\nchoose contacts and finish each piece"];
  review [label="4. Review model\nchosen proposal + selector score/margin + final bounds\nscore each final rally for manual review"];

  candidates -> contact;
  contact -> selected;
  contact -> pool;
  selected -> options;
  pool -> options;
  options -> first -> split;
  split -> piece_options [label="split pieces"];
  pool -> piece_options [label="full candidate rows"];
  piece_options -> second -> review;
  split -> review [label="unchanged rallies"];
}
