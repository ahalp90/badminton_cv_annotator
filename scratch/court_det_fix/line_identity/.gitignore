# Working cruft
__pycache__/
*.pyc
.ruff_cache/
.pyrefly_cache/
.pytest_cache/
*.pid
*.lock

# Private aliases for the remote host, user and absolute paths
paths.local.sh

# The repository root ignores every runs/ directory; this one holds the committed
# experiment records, so re-include it before the specific exclusions.
!runs/

# Gigantic record assets stay on disk and are listed with size and MD5 in the manifest:
# per-pair court arrays and the full per-candidate court records from the matcher stages.
runs/**/*.npz
runs/**/*.npy.xz
runs/**/cache/
runs/**/e4/*/results/
runs/**/matcher/*/results/
